<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_create_project_sheet"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="10dp"
    android:paddingEnd="22dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@color/aicli_outline_strong" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="创建项目"
        android:textColor="@color/aicli_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="18dp"
        android:text="目录和启动命令由当前电脑统一管理，创建后不会自动启动。"
        android:textColor="@color/aicli_text_secondary"
        android:textSize="13sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/projectNameLayout"
        style="@style/Widget.Material3.TextInputLayout.FilledBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="项目名称"
        app:boxBackgroundColor="@color/aicli_surface_high"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusTopStart="14dp"
        app:boxStrokeColor="@color/aicli_primary"
        app:hintTextColor="@color/aicli_text_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/projectNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:hint="例如：BlackBox"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLength="80"
            android:maxLines="1"
            android:minHeight="56dp"
            android:singleLine="true"
            android:textColor="@color/aicli_text"
            android:textColorHint="@color/aicli_text_tertiary" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/projectTypeLayout"
        style="@style/Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="项目类型"
        app:boxBackgroundColor="@color/aicli_surface_high"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusTopStart="14dp"
        app:boxStrokeColor="@color/aicli_primary"
        app:endIconTint="@color/aicli_text_secondary"
        app:hintTextColor="@color/aicli_text_secondary">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/projectTypeSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:inputType="none"
            android:maxLines="1"
            android:minHeight="56dp"
            android:singleLine="true"
            android:textColor="@color/aicli_text"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/projectGroupLayout"
        style="@style/Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="项目分组"
        app:boxBackgroundColor="@color/aicli_surface_high"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusTopStart="14dp"
        app:boxStrokeColor="@color/aicli_primary"
        app:endIconTint="@color/aicli_text_secondary"
        app:hintTextColor="@color/aicli_text_secondary">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/projectGroupSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:inputType="none"
            android:maxLines="1"
            android:minHeight="56dp"
            android:singleLine="true"
            android:textColor="@color/aicli_text"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="项目目录"
        android:textColor="@color/aicli_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/projectPathPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_project_path_preview"
        android:ellipsize="middle"
        android:maxLines="2"
        android:padding="13dp"
        android:text="正在读取电脑端设置…"
        android:textColor="@color/aicli_text_secondary"
        android:textIsSelectable="true"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/projectCreationStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="20dp"
        android:textColor="@color/aicli_connection_failed"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelCreateProjectButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="取消"
            android:textColor="@color/aicli_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirmCreateProjectButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:enabled="false"
            android:text="创建"
            app:backgroundTint="@color/aicli_primary"
            app:cornerRadius="14dp" />
    </LinearLayout>
</LinearLayout>
</androidx.core.widget.NestedScrollView>
