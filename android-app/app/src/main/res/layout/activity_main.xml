<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aicli_background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/aicli_background"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/mainHeader"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/conversationsButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="打开会话列表"
                android:padding="12dp"
                android:src="@drawable/ic_menu"
                app:tint="@color/aicli_text" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="8dp">

                <TextView
                    android:id="@+id/currentComputerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="未绑定电脑"
                    android:textColor="@color/aicli_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/localConnectionIcon"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:contentDescription="本地，未连接"
                        android:src="@drawable/ic_local_network"
                        app:tint="@color/aicli_text_tertiary" />

                    <ImageView
                        android:id="@+id/localCurrentRouteIcon"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="1dp"
                        android:contentDescription="当前连接"
                        android:src="@drawable/ic_current_route"
                        android:visibility="gone"
                        app:tint="@color/aicli_primary" />

                    <ImageView
                        android:id="@+id/remoteConnectionIcon"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="12dp"
                        android:contentDescription="远程，未连接"
                        android:src="@drawable/ic_remote_network"
                        app:tint="@color/aicli_text_tertiary" />

                    <ImageView
                        android:id="@+id/remoteCurrentRouteIcon"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="1dp"
                        android:contentDescription="当前连接"
                        android:src="@drawable/ic_current_route"
                        android:visibility="gone"
                        app:tint="@color/aicli_primary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/currentProjectMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="未选择项目 · 未设置类型"
                    android:textColor="@color/aicli_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/scanButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="扫描二维码绑定电脑"
                android:padding="11dp"
                android:src="@drawable/ic_qr"
                app:tint="@color/aicli_text_secondary" />

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="设置"
                android:padding="11dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/aicli_text_secondary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/aicli_outline" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/conversationContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="0dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp">

                <!--
                    The terminal consumes the remaining height. The composer is
                    a normal sibling below it, never a floating layer over the
                    terminal content.
                -->
                <FrameLayout
                    android:id="@+id/terminalStage"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <com.aitest.aicli.TerminalView
                        android:id="@+id/terminalView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_terminal"
                        android:clipToOutline="true"
                        android:fadeScrollbars="false"
                        android:overScrollMode="never"
                        android:paddingStart="14dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="14dp"
                        android:scrollbarStyle="insideOverlay"
                        android:scrollbars="horizontal|vertical"
                        android:visibility="gone" />
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/startProjectButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="开始项目"
                    android:textAllCaps="false"
                    android:textColor="@color/aicli_text"
                    android:textSize="14sp"
                    android:visibility="gone"
                    app:backgroundTint="@color/aicli_surface_high"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/aicli_outline_strong"
                    app:strokeWidth="1dp" />

                <LinearLayout
                    android:id="@+id/inputBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_composer"
                    android:gravity="bottom|center_vertical"
                    android:minHeight="50dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/messageInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:gravity="center_vertical"
                        android:hint="给当前 AI CLI 发送消息…"
                        android:imeOptions="actionSend"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:maxLines="5"
                        android:minHeight="40dp"
                        android:paddingStart="0dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="8dp"
                        android:textColor="@color/aicli_text"
                        android:textColorHint="@color/aicli_text_tertiary"
                        android:textSize="15sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sendButton"
                        style="@style/Widget.Material3.Button.IconButton.Filled"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:contentDescription="展开终端按键"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        app:backgroundTint="@color/aicli_surface_high"
                        app:cornerRadius="19dp"
                        app:icon="@drawable/ic_add"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="20dp"
                        app:iconTint="@color/aicli_text_secondary"
                        app:strokeColor="@color/aicli_outline_strong"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <!--
                    This panel replaces the IME instead of permanently using
                    terminal height. MainActivity updates its pixel height to
                    the last visible keyboard height before showing it.
                -->
                <LinearLayout
                    android:id="@+id/terminalKeyBar"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:background="@drawable/bg_terminal_key_panel"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="18dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/wrapButton"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:text="换行"
                            android:textAllCaps="false"
                            android:textColor="@color/aicli_text_secondary"
                            android:textSize="13sp"
                            app:backgroundTint="@color/aicli_surface_high"
                            app:cornerRadius="14dp"
                            app:strokeColor="@color/aicli_outline"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/keyUpButton"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:text="↑"
                            android:textAllCaps="false"
                            android:textColor="@color/aicli_text"
                            android:textSize="21sp"
                            app:backgroundTint="@color/aicli_surface_high"
                            app:cornerRadius="14dp"
                            app:strokeColor="@color/aicli_outline"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/keyEnterButton"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:text="回车"
                            android:textAllCaps="false"
                            android:textColor="@color/aicli_text"
                            android:textSize="13sp"
                            app:backgroundTint="@color/aicli_surface_high"
                            app:cornerRadius="14dp"
                            app:strokeColor="@color/aicli_outline"
                            app:strokeWidth="1dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/keyLeftButton"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:text="←"
                            android:textAllCaps="false"
                            android:textColor="@color/aicli_text"
                            android:textSize="21sp"
                            app:backgroundTint="@color/aicli_surface_high"
                            app:cornerRadius="14dp"
                            app:strokeColor="@color/aicli_outline"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/keyDownButton"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:text="↓"
                            android:textAllCaps="false"
                            android:textColor="@color/aicli_text"
                            android:textSize="21sp"
                            app:backgroundTint="@color/aicli_surface_high"
                            app:cornerRadius="14dp"
                            app:strokeColor="@color/aicli_outline"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/keyRightButton"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:text="→"
                            android:textAllCaps="false"
                            android:textColor="@color/aicli_text"
                            android:textSize="21sp"
                            app:backgroundTint="@color/aicli_surface_high"
                            app:cornerRadius="14dp"
                            app:strokeColor="@color/aicli_outline"
                            app:strokeWidth="1dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/cameraButton"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:text="拍照"
                            android:textAllCaps="false"
                            android:textColor="@color/aicli_text"
                            android:textSize="13sp"
                            app:backgroundTint="@color/aicli_surface_high"
                            app:cornerRadius="14dp"
                            app:icon="@drawable/ic_camera"
                            app:iconPadding="8dp"
                            app:iconSize="20dp"
                            app:iconTint="@color/aicli_text_secondary"
                            app:strokeColor="@color/aicli_outline"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/galleryButton"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:text="相册"
                            android:textAllCaps="false"
                            android:textColor="@color/aicli_text"
                            android:textSize="13sp"
                            app:backgroundTint="@color/aicli_surface_high"
                            app:cornerRadius="14dp"
                            app:icon="@drawable/ic_gallery"
                            app:iconPadding="8dp"
                            app:iconSize="20dp"
                            app:iconTint="@color/aicli_text_secondary"
                            app:strokeColor="@color/aicli_outline"
                            app:strokeWidth="1dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/aicli_background"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="36dp">

                <TextView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_status_pill"
                    android:gravity="center"
                    android:text=">_"
                    android:textColor="@color/aicli_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/emptyStateTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:text="连接你的 AI 工作台"
                    android:textColor="@color/aicli_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/emptyStateMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="扫描电脑端二维码后，即可查看进度并继续当前会话。"
                    android:textColor="@color/aicli_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/conversationDrawer"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_drawer"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="项目与会话"
                android:textColor="@color/aicli_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/closeDrawerButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="关闭会话列表"
                android:padding="10dp"
                android:rotation="180"
                android:src="@drawable/ic_back"
                app:tint="@color/aicli_text_secondary" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/computerSelectorLayout"
            style="@style/Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="当前服务端"
            app:boxBackgroundColor="@color/aicli_surface"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="@color/aicli_outline_strong"
            app:endIconTint="@color/aicli_text_secondary"
            app:hintTextColor="@color/aicli_text_secondary">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/computerSelector"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:inputType="none"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingTop="0dp"
                android:paddingEnd="8dp"
                android:paddingBottom="0dp"
                android:textColor="@color/aicli_text"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/groupSelectorLayout"
            style="@style/Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="当前分组"
            app:boxBackgroundColor="@color/aicli_surface"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="@color/aicli_outline_strong"
            app:endIconTint="@color/aicli_text_secondary"
            app:hintTextColor="@color/aicli_text_secondary">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/groupSelector"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:inputType="none"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingTop="0dp"
                android:paddingEnd="8dp"
                android:paddingBottom="0dp"
                android:textColor="@color/aicli_text"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/drawerGroupLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="6dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            android:text="全部分组"
            android:textColor="@color/aicli_text_secondary"
            android:textSize="12sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/conversationList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="ifContentScrolls"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/drawerConnectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_status_pill"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="未连接"
            android:textColor="@color/aicli_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
