<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C0E12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="电脑连接"
            android:textColor="#F1F4F9"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="已绑定电脑也可以在断网后自动重新认证，不需要再次确认。手工地址仅支持 HTTPS。"
            android:textColor="#8B94A2"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="电脑访问地址"
            android:textColor="#C8D0DC" />

        <EditText
            android:id="@+id/baseUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#539CFF"
            android:hint="例如 https://192.168.1.10:4280"
            android:inputType="textUri"
            android:textColor="#F1F4F9"
            android:textColorHint="#6F7887" />

        <Button
            android:id="@+id/saveConnectionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="保存地址并连接" />

        <Button
            android:id="@+id/addComputerButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="在 App 内扫描二维码绑定电脑" />

        <Button
            android:id="@+id/clearComputerButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="清除当前电脑连接" />

        <TextView
            android:id="@+id/computerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#AEB8C7"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="#29313D" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="应用设置"
            android:textColor="#F1F4F9"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/notificationSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="任务完成通知"
            android:textColor="#C8D0DC" />

        <Switch
            android:id="@+id/vibrationSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="震动提醒"
            android:textColor="#C8D0DC" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="版本 0.1.0 · 私钥由 Android Keystore 管理"
            android:textColor="#6F7887" />
    </LinearLayout>
</ScrollView>
