<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="4dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/computerDetailStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pill"
            android:textColor="@color/aicli_running"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/computerDetailMetadata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="5dp"
            android:textColor="@color/aicli_text_secondary"
            android:textIsSelectable="true"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="连接优先级"
            android:textColor="@color/aicli_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/computerRoutePreferenceGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/computerPreferLocalButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="局域网优先"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/computerPreferRemoteButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="广域网优先"
                android:textAllCaps="false" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/computerRoutePreferenceHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/aicli_text_tertiary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="访问地址"
            android:textColor="@color/aicli_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/computerLocalAddressLayout"
            style="@style/Widget.Material3.TextInputLayout.FilledBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="局域网地址"
            app:boxBackgroundColor="@color/aicli_surface_high"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="@color/aicli_primary"
            app:helperText="用于同一网络内直连，可留空"
            app:hintTextColor="@color/aicli_text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/computerLocalAddressInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="https://192.168.1.10:4280"
                android:inputType="textUri"
                android:maxLines="1"
                android:textColor="@color/aicli_text"
                android:textColorHint="@color/aicli_text_tertiary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/computerRemoteAddressLayout"
            style="@style/Widget.Material3.TextInputLayout.FilledBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="公网 / Relay 地址"
            app:boxBackgroundColor="@color/aicli_surface_high"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="@color/aicli_primary"
            app:helperText="用于公网或 Relay 访问，可留空"
            app:hintTextColor="@color/aicli_text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/computerRemoteAddressInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="https://relay.example.com/aicli"
                android:inputType="textUri"
                android:maxLines="1"
                android:textColor="@color/aicli_text"
                android:textColorHint="@color/aicli_text_tertiary" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</ScrollView>
