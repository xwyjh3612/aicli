# Native desktop build and staged runtime
/desktop/build/
/desktop/build-qt/
/desktop/build-qt-release/
/desktop/build-nonqt-release/
/desktop/bin/
/desktop/installer/output/
/target/

# Keep the distributable installers and their checksums in Git
/release/*
!/release/AI-CLI-Setup-1.0.0.3-x64.exe
!/release/AI-CLI-Setup-1.0.0.3-x64.exe.sha256
!/release/AI-CLI-Android-1.1.0-release.apk
!/release/AI-CLI-Android-1.1.0-release.apk.sha256
!/release/AI-CLI-Setup-1.0.0.4-x64.exe
!/release/AI-CLI-Setup-1.0.0.4-x64.exe.sha256
!/release/AI-CLI-Setup-1.0.0.5-x64.exe
!/release/AI-CLI-Setup-1.0.0.5-x64.exe.sha256
!/release/AI-CLI-Android-1.2.0-release.apk
!/release/AI-CLI-Android-1.2.0-release.apk.sha256

# Android/Gradle build state
/android-app/.gradle/
/android-app/**/build/
/android-app/local.properties

# IDE and compiler-local files
.vs/
.idea/
.vscode/
*.user
*.suo
*.VC.db
*.opendb
*.pdb
*.ilk
*.class
__pycache__/

# Local diagnostics and crash output
/desktop/tools/cdb-*.txt
/local-screenshots/
*.log
*.dmp
*.trace

# Local credentials and environment overrides
.env
.env.*
!.env.example
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
*.dpapi
/signing/
/android-app/signing/

# Operating-system noise
Thumbs.db
Desktop.ini
.DS_Store
